# Copy this to .env.production on the Pi and fill in real values

# Stripe live keys — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_

# Stripe webhook secret — register endpoint at dashboard.stripe.com/webhooks
# pointing at https://yourdomain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_

# Your site's public URL (no trailing slash)
# Set BOTH of these to the same value. NEXT_PUBLIC_APP_URL only exists for
# client-side code and gets baked into the build at Docker build time (see
# Dockerfile), so it does NOT reflect this file's value at runtime — server
# code (e.g. Stripe checkout redirect/image URLs) must read the plain
# APP_URL var instead, since that one IS read live at container start.
NEXT_PUBLIC_APP_URL=https://yourdomain.com
APP_URL=https://yourdomain.com

# MariaDB (Docker `db` service) — used for users, purchase data, content metadata
DB_HOST=db
DB_NAME=thebreaksite
DB_USER=tbs
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# R2 object storage (S3 API) — file bytes live here, never in MariaDB
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=thebreaksite-uploads

# Random secret for signing admin session JWTs
# Generate one with: openssl rand -hex 32
ADMIN_JWT_SECRET=

# Secret for the daily cron hitting /api/cron/review-emails (sent as
# "Authorization: Bearer <value>"). Generate one with: openssl rand -hex 32
CRON_SECRET=

# Resend — resend.com/api-keys
RESEND_API_KEY=re_
RESEND_WEBHOOK_SECRET=whsec_
# Comma-separated sender addresses available in the Email panel.
MAIL_FROM_ADDRESSES=nathan@thebreaksurf.co.uk,orders@thebreaksurf.co.uk
MAIL_DEFAULT_FROM=nathan@thebreaksurf.co.uk
# Addresses shown as individual inboxes in the Email sidebar.
MAIL_INBOX_ADDRESSES=nathan@thebreaksurf.co.uk,orders@thebreaksurf.co.uk,support@thebreaksurf.co.uk
RECEIPTS_INBOX_ADDRESS=receipts@thebreaksurf.co.uk
# OpenCode Zen API for receipt extraction (Google AI SDK format)
ZEN_API_KEY=
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_MODEL=gemini-3.5-flash-lite



# Web Push notifications — generate a pair with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:nathan@thebreaksurf.co.uk

# ERPNext
ERPNEXT_URL=https://your-erpnext.example.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
NEXT_PUBLIC_ERPNEXT_URL=https://your-erpnext.example.com

# Till (terminal.thebreaksurf.co.uk) — staff PIN for the card-only point of sale
TILL_PIN=
