{
  "name": "the-break-surf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && wrangler dev",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "mysql -h ${DB_HOST:-127.0.0.1} -u ${DB_USER:-tbs} -p${DB_PASSWORD} ${DB_NAME:-thebreaksite} < db/migrations/001_init.sql",
    "db:seed": "node db/seed.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@opennextjs/cloudflare": "^1.20.4",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "mdast-util-find-and-replace": "^3.0.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.14.0",
    "stripe": "^22.6.0",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.127.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@tailwindcss/postcss": "^4",
