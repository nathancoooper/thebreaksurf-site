# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Claude Code local config
.claude/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Uploaded files — live in Docker volume, never in git
public/images/uploads/

# Runtime data — lives in Docker volume, never in git
data/users.json
data/users*.json
data/login-log.json
data/email-messages.json
data/email-settings.json
data/email-attachments/
data/whiteboards/
data/social.json
data/tasks.json
data/meetings.json
data/people.json
data/pending-checkouts/
data/stock-snapshot.json
data/university-submissions/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.open-next/

# Uploads belong in R2, not in the repo
public/images/uploads/*
!public/images/uploads/.gitignore

# Wrangler state
.wrangler/
